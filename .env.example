# FindIt — Environment Configuration (Template)

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB)
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/findit?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/findit

# Authentication Secret
JWT_SECRET=findit_super_secret_jwt_key_2026_college_mini_project_change_in_production
JWT_EXPIRES_IN=7d

# Optional Cloudinary Configuration (Leave empty if not using cloud uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
